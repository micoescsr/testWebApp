# ─── Backend Environment Variables (PRODUCTION) ────────────────────
# Set these in Railway Dashboard → Service → Variables.
# NEVER put real production values in a file — Railway env vars only.

APP_ENV=production
NODE_ENV=production

# Supabase (PROD project — completely separate from dev)
SUPABASE_URL=https://YOUR_PROD_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key

# JWT
JWT_SECRET=your-prod-jwt-secret

# FastAPI / Pi gateway (Tailscale Funnel public URL)
FASTAPI_BASE_URL=https://your-pi.tail12345.ts.net

# CORS — production frontend domain(s), comma-separated
ALLOWED_ORIGINS=https://yourapp.up.railway.app,https://yourdomain.com

# Pi control secrets
CONTROL_SIGNING_SECRET=long-random-prod-signing-secret

# Portal patch auth token — canonical name.
# Older deployments may still set PORTAL_TOKEN; code checks PORTAL_PATCH_TOKEN first.
PORTAL_PATCH_TOKEN=long-random-prod-portal-token

SCAN_RUNNER_TOKEN=long-random-prod-scan-token

# Server port (Railway injects PORT automatically — usually no need to set)
# PORT=3000
