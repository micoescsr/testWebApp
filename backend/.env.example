# ═══════════════════════════════════════════════════════════════════
#  Backend Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git — it is gitignored.
# ═══════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
NODE_ENV=development
PORT=3001

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── CORS / Allowed Origins ───────────────────────────────────────
# Comma-separated list of allowed origins for CORS and CSRF checks.
# Dev:  http://localhost:5173
# Prod: https://web-dev-1-production.up.railway.app
# Get the value from Railway → your frontend service → Settings → Public Networking
ALLOWED_ORIGINS=http://localhost:5173

# ── Cross-Origin Cookies ─────────────────────────────────────────
# Set to "true" when frontend and backend are on DIFFERENT domains
# (e.g., separate Railway services). Switches cookies to
# SameSite=None; Secure — required for cross-origin cookie auth.
# Leave unset or "false" for same-origin (local dev).
CROSS_ORIGIN_COOKIES=

# ── FastAPI / Raspberry Pi ───────────────────────────────────────
# URL to the Pi gateway (via Tailscale Funnel in prod, localhost in dev).
# Do NOT hardcode the Tailscale URL here — use the Funnel public URL in prod.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# ── Pi Control Secrets (Phase 0-E) ──────────────────────────────
# HMAC signing secret for Express → Pi commands.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must match the value on the Pi. NEVER prefix with VITE_.
CONTROL_SIGNING_SECRET=
# Portal patch auth token (sent as x-portal-token header to FastAPI).
# Canonical env var. Older deployments may still use PORTAL_TOKEN — the code
# checks PORTAL_PATCH_TOKEN first and falls back to PORTAL_TOKEN.
PORTAL_PATCH_TOKEN=

# ── Webhook Auth ─────────────────────────────────────────────────
# Shared secret for scan-completed webhook (Pi → Express).
# Must be set in production — empty string means webhook is OPEN.
SCAN_RUNNER_TOKEN=
