# ═══════════════════════════════════════════════════════════════════
#  Frontend Environment Variables (Vite)
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git — it is gitignored.
#  All variables MUST start with VITE_ to be exposed to the browser.
# ═══════════════════════════════════════════════════════════════════

# ── API Base URL ─────────────────────────────────────────────────
# Dev:  leave blank — Vite proxy forwards /api → localhost:3000
# Prod: full URL of your Railway backend service (include /api prefix)
#       e.g. https://api-dev-production.up.railway.app/api
# Get the value from Railway → your API service → Settings → Public Networking
VITE_API_BASE_URL=

# ── Supabase ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
